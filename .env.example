# Copy to .env and fill in. The server does not read .env itself:
# load it into the environment before starting, e.g. `set -a; . ./.env; set +a`.

# OpenRouter key (sk-or-v1-...) for JEV classification. Leave empty to disable AI;
# payee history and Show request still work without it.
OPENROUTER_API_KEY=

# Optional: JEV model. Defaults to ~typesafe/jev-latest.
JEV_MODEL="~typesafe/jev-latest"
