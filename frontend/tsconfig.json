{
  "compilerOptions": {
    "target": "ES2015",
    "types": ["react", "react-dom"],
    "module": "ES2015",
    "moduleResolution": "node",  
    "jsx": "react",
    "sourceMap": true,
    "strict": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "experimentalDecorators": true
  }
}
